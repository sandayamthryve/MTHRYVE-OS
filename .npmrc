# @vercel/speed-insights declares OPTIONAL framework peers (@sveltejs/kit, etc.)
# that this app does not use. npm's strict peer resolver tries to satisfy those
# optional peers anyway and pulls in a conflicting vite (svelte-kit wants vite@8,
# vitest pins vite@5), failing the install. legacy-peer-deps relaxes that strict
# resolution — the optional peers are simply skipped, which is the intended
# behavior. Read by both local `npm install` and the Vercel build.
legacy-peer-deps=true
