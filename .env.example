# ── Database-free application access gate ────────────────────────────────────
# Optional outer perimeter for private/preview deployments. It runs before
# Supabase, so it still protects the app while the database is unavailable.
# Set APP_GATE_ENABLED=true and provide both credentials to enable HTTP Basic
# authentication. If enabled with either credential missing, requests fail
# closed with 503. Use only over HTTPS and choose a long, unique password.
APP_GATE_ENABLED=false
APP_GATE_USERNAME=
APP_GATE_PASSWORD=

# Copy to .env.local for local development. Never commit the real file.
# Production values live in Vercel + Supabase project settings only —
# see DECISIONS.md D-006.

# From Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only, NEVER exposed via NEXT_PUBLIC_*.
# Used only in trusted server contexts (e.g. seeding scripts), not in
# any route handler that serves user requests directly.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flag: point the Command Center Revenue KPI at the canonical
# /api/os/snapshot read instead of the inline server figure. Default "false"
# (OFF) — leave unset in production until the snapshot is verified. When "true",
# only the Command KPI value switches source; every other surface is unchanged.
NEXT_PUBLIC_USE_SNAPSHOT=false

# Anthropic API key — server-side only (Milestone 5, AI Assistant).
# Referenced only inside app/api/ route handlers.
ANTHROPIC_API_KEY=

# Safe agent UI testing without Anthropic usage or database writes. When true,
# Atlas, Care, Herald, Oracle, and Prospector return clearly labelled fixtures
# before any AI tool loop runs. Authentication still applies. Never creates an
# approval, sends a message, or performs an external action.
AGENT_MOCK_MODE=false

# OpenAI API key — powers Tony's hands-free voice: Whisper speech-to-text
# (/api/voice/transcribe) and OpenAI TTS for the spoken reply (/api/voice/speak).
# Server-side ONLY, never NEXT_PUBLIC_*. Read at call time inside lib/voice/openai.ts
# and the app/api/voice/* routes; it never reaches the browser. From the OpenAI
# dashboard → API keys (platform.openai.com). Leave blank to fall back to the
# browser's built-in Web Speech engines (no key needed) — the "Hey Tony" wake word
# is always in-browser and free regardless. Diag: /api/voice/diag.
#
# The SAME key also powers the Knowledge base: text-embedding-3-small (1536-dim)
# embeddings for both document ingestion (lib/knowledge/ingest) and semantic
# retrieval (lib/knowledge/search -> match_document_chunks). Read at call time in
# lib/knowledge/embed.ts; never reaches the browser. Without it, uploads save but
# ingestion fails (status 'failed') and searchKnowledge throws "not-configured".
OPENAI_API_KEY=

# ── Tony's voice (PLUGGABLE neural TTS) ──────────────────────────────────────
# Swap Tony's spoken voice WITHOUT a code change. All server-side only, read at
# call time in lib/voice/tts.ts; never NEXT_PUBLIC_*, never returned to the
# browser. If none of these are set, Tony falls back to the browser's free Web
# Speech voice — it never errors and never fakes audio. Speech-to-text stays on
# OpenAI Whisper (OPENAI_API_KEY) / the browser; only the OUTPUT voice is swapped.
#
# TTS_PROVIDER — kokoro | openai | elevenlabs. Leave blank to auto-use OpenAI TTS
#   when OPENAI_API_KEY is set (backwards-compatible), else browser fallback.
#   • kokoro     — a self-hosted, OpenAI-compatible /v1/audio/speech endpoint
#                  (free to run, no per-word cost). TTS_ENDPOINT is REQUIRED;
#                  TTS_API_KEY optional (many Kokoro servers are keyless).
#   • openai     — OpenAI TTS (or any OpenAI-compatible host via TTS_ENDPOINT).
#   • elevenlabs — ElevenLabs; TTS_API_KEY required, TTS_VOICE is the voice id.
# TTS_ENDPOINT — base URL or full speech endpoint. Required for kokoro; optional
#   for openai (defaults to api.openai.com) and elevenlabs (defaults to their API).
# TTS_API_KEY  — provider key/token. Optional for a keyless self-hosted Kokoro.
# TTS_VOICE    — voice id/name (provider default otherwise).
# TTS_MODEL    — model id (provider default otherwise).
# Diag (booleans + provider name only, no key): /api/voice/diag.
TTS_PROVIDER=
TTS_ENDPOINT=
TTS_API_KEY=
TTS_VOICE=
TTS_MODEL=

# Email channel for Vesper's gated outreach (V2). Server-side ONLY, never
# NEXT_PUBLIC_*. Read at CALL TIME inside lib/outreach/email.ts; the credentials
# never reach the browser. Vesper DRAFTS auto; email only SENDS after a human
# approves a 'send_outreach' request — and only if a transport below is
# configured. If NEITHER is set, an approved email send fails with a clear
# "email not configured" state and NOTHING is sent (never a faked send). Viber
# and comment/DM replies are copy-paste only and need no config.
#
# Pick ONE transport:
#   • SMTP (sent with nodemailer) — set SMTP_HOST plus a from address. SMTP_PORT
#     defaults to 587 (STARTTLS); set SMTP_SECURE=true (or port 465) for implicit
#     TLS. SMTP_USER/SMTP_PASS are optional (omit for an open relay).
#   • Provider API (sent over HTTPS, no SDK) — set EMAIL_API_KEY plus EMAIL_FROM.
#     Defaults to Resend (https://api.resend.com/emails); override the endpoint
#     with EMAIL_API_URL for any Resend-compatible provider.
# EMAIL_FROM (or SMTP_FROM) is the verified sender and is required for either.
EMAIL_FROM=
# --- SMTP transport ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
SMTP_FROM=
# --- Provider API transport ---
EMAIL_API_KEY=
EMAIL_API_URL=

# Canva Connect API — OAuth 2.0 + PKCE. Server-side only (never NEXT_PUBLIC_*).
# From the Canva Developer portal (developer.canva.com). The connect flow reads
# these; tokens are stored in the RLS-locked public.canva_connections vault and
# reached only with SUPABASE_SERVICE_ROLE_KEY. Redirect URI is fixed to
# https://mthryve-os.vercel.app/api/canva/callback (register it in the portal).
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# HeyGen AI-video API — a single org-wide API key sent as the x-api-key header
# (NO OAuth). Server-side only, never NEXT_PUBLIC_*. Read at call time inside
# lib/heygen/client.ts and the app/api/integrations/heygen/* routes. From the
# HeyGen dashboard → Settings → API. Spends real money per render, so the editor
# gates every generate behind a cost preview + leadership approval.
HEYGEN_API_KEY=

# Optional shared secret guarding the HeyGen completion webhook. When set, the
# webhook receiver requires a matching ?secret=… on the URL you register in the
# HeyGen dashboard (Webhooks). Leave blank to accept unauthenticated callbacks
# (fine for local/first-run; set it in production).
HEYGEN_WEBHOOK_SECRET=

# fal.ai generative-video API — a single org-wide key sent as the
# `Authorization: Key <FAL_KEY>` header (NO OAuth). Server-side only, never
# NEXT_PUBLIC_*. Read at call time inside lib/fal/client.ts and the
# app/api/integrations/video/* routes. From the fal dashboard → Keys. Spends real
# money per clip, so the editor gates every generate behind a model pick + cost
# preview + leadership approval. Diag: /api/integrations/video/diag.
FAL_KEY=

# Optional shared secret guarding the fal completion webhook. When set, the
# submit attaches ?fal_webhook=<url>?secret=… and the receiver requires a match.
# Leave blank to accept unauthenticated callbacks (fine for local/first-run; set
# it in production). The /status poll finalises clips regardless.
FAL_WEBHOOK_SECRET=

# JSON2Video movie-assembly API — a single org-wide key sent as the x-api-key
# header (NO OAuth). Server-side only, never NEXT_PUBLIC_*. Read at call time
# inside lib/json2video/client.ts and the app/api/integrations/assembly/* routes.
# From the JSON2Video dashboard → API. Composes an item's Creative Kit (clips +
# visuals + captions + music) into one finished MP4; spends real money per render,
# so the editor gates every assembly behind a cost preview + leadership approval.
# Diag: /api/integrations/assembly/diag → { hasKey }.
JSON2VIDEO_API_KEY=

# Optional shared secret guarding the JSON2Video completion webhook. When set, the
# submit registers a ?secret=… webhook (exports.destinations) and the receiver
# requires a match. Leave blank to accept unauthenticated callbacks (fine for
# local/first-run; set it in production). The /status poll finalises renders
# regardless.
JSON2VIDEO_WEBHOOK_SECRET=

# TikTok Shop Partner API — app credentials (server-side only, never
# NEXT_PUBLIC_*). Read at request time inside lib/tiktok/* and the
# app/api/integrations/tiktok/* routes. From Partner Center → your App. Used to
# sign every business call and to exchange/refresh OAuth tokens.
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# The service registered in Partner Center (owns the redirect URL + scopes).
TIKTOK_SERVICE_ID=
# Optional: override the OAuth redirect URI when it can't be derived from origin.
TIKTOK_REDIRECT_URI=

# Layer-5 automation gateway secret — the shared bearer token guarding
# POST /api/automation/opportunities. n8n's Opportunity Engine sends it as
# `Authorization: Bearer ${AUTOMATION_API_KEY}` via its "Mthryve OS Automation
# Key" credential; the route rejects any non-matching/missing bearer with 401 and
# fails CLOSED when this is unset. Server-side only, never NEXT_PUBLIC_*. Set the
# SAME value in Vercel (Production) and in the n8n credential. n8n never touches
# the database — it only calls this HTTPS endpoint. Also guards the Vesper Phase-2
# pipeline routes (POST /api/vesper/transcribe + /api/vesper/segment), which n8n
# polls on a schedule to advance clip jobs one stage per call (see
# docs/VESPER_STUDIO.md), the Daily Tap (POST /api/automation/daily-tap), the
# probation auto-flag (POST /api/automation/probation-review-scan) and the TikTok
# sync-health monitor (POST/GET /api/automation/sync-health-check — n8n's daily
# schedule hits it to alert leadership when the sync is missing/failed or a token
# is expiring soon).
AUTOMATION_API_KEY=

# HMAC signing secret for the n8n → OS webhooks (PASTE 3.2 — Part A). LAYERED ON
# TOP of AUTOMATION_API_KEY: n8n signs the RAW request body with this secret
# (HMAC-SHA256, hex) and sends the digest in the `x-mthryve-signature` header;
# the OS recomputes it and rejects any request whose signature is missing or
# doesn't match — so a forged/unsigned opportunity is blocked EVEN IF the bearer
# leaks. The signature gate FAILS CLOSED: when this is unset, the signed webhook
# routes (/api/automation/opportunities and the n8n path of /api/csi/research)
# reject every call. Server-side only, never NEXT_PUBLIC_*. Set the SAME value in
# Vercel (Production) and in the n8n HMAC/Crypto node's key. Keep it DISTINCT
# from AUTOMATION_API_KEY — two independent secrets is the whole point.
WEBHOOK_SIGNING_SECRET=

# Optional shared secret for the daily TikTok read-sync cron
# (/api/integrations/tiktok/sync). When set, Vercel Cron authenticates with
# `Authorization: Bearer ${CRON_SECRET}`; a signed-in leadership session can also
# trigger a manual "Sync now". Leave blank to allow only the leadership path.
# The SAME secret authenticates the hourly anomaly monitor
# (/api/security/anomaly-scan) and the Automation Radar scan.
CRON_SECRET=

# ── Auth regression gate — production synthetic monitor (Phase 0.4) ───────────
# The production heartbeat route (/api/monitor/auth-health) is protected by
# CRON_SECRET above and driven by a scheduled GitHub Actions workflow
# (.github/workflows/auth-heartbeat.yml, every ~10 min) that sends CRON_SECRET as
# a bearer token — so the route is NOT publicly triggerable. (The schedule lives
# in GitHub Actions, not vercel.json, because */5 Vercel Cron is Pro-only and
# Hobby rejects the deployment at parse time.) CRON_SECRET must therefore exist
# BOTH in the Vercel env (for the route) AND as a GitHub Actions secret (for the
# workflow). OPTIONAL override for the URL the route probes; defaults to the live
# production login screen (https://mthryve-os.vercel.app/login).
MONITOR_AUTH_HEALTH_URL=

# ── Auth regression gate — Playwright E2E (Phase 0.4) ─────────────────────────
# These drive the auth-e2e CI gate (.github/workflows/auth-e2e.yml). In CI they
# come from GitHub Actions secrets, NOT this file — listed here for local runs
# (`npm run test:e2e`) and documentation.
#
# E2E_BASE_URL — the deployment under test. In CI this is the Vercel preview URL
#   (github.event.deployment_status.target_url); locally set your dev/preview URL.
E2E_BASE_URL=
# E2E_USER_EMAIL / E2E_USER_PASSWORD — the DEDICATED Supabase test user. This is
#   NOT a real employee account: a normal RLS-scoped team_member in the existing
#   org, created only so CI can exercise the real auth gate. Do NOT delete it (see
#   the PR that introduced this gate). Never grant it ceo/coo; never a service key.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
# VERCEL_AUTOMATION_BYPASS_SECRET — Vercel Deployment Protection SSO-walls preview
#   URLs; a headless browser can't pass that wall. Generate under Project →
#   Settings → Deployment Protection → Protection Bypass for Automation, and store
#   it as a GitHub Actions secret. playwright.config.ts sends it on every request
#   (x-vercel-protection-bypass + x-vercel-set-bypass-cookie). CI only — do NOT
#   disable Deployment Protection itself.
VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Security anomaly monitoring (PASTE 4.3 — Part D) ──────────────────────────
# All OPTIONAL — sane defaults ship in lib/security/anomaly.ts. Set any to tune
# the hourly monitor (/api/security/anomaly-scan) WITHOUT a code change. Alerts go
# to leadership via the existing Telegram channel and land in security_anomalies.
# AI_USD_PHP — USD→PHP rate used to estimate AI spend in ai_usage_log (default 58).
AI_USD_PHP=
# INCIDENT_RUNBOOK_URL — link included in every anomaly alert (default: the repo's
# docs/INCIDENT_RUNBOOK.md).
INCIDENT_RUNBOOK_URL=
# Detection window + baseline + spike sensitivity.
ANOMALY_WINDOW_MINUTES=
ANOMALY_BASELINE_DAYS=
ANOMALY_SPIKE_FACTOR=
# Absolute floors so a quiet baseline never fires on trivial activity.
ANOMALY_SPEND_FLOOR_PHP=
ANOMALY_MASS_READ_FLOOR=
ANOMALY_FAILED_LOGIN_FLOOR=
ANOMALY_RLS_DENIAL_FLOOR=
ANOMALY_EXPORT_FLOOR=

# ── Multi-factor authentication (PASTE B) ─────────────────────────────────────
# Master switch for MFA ENFORCEMENT at login. Users can enroll a TOTP
# authenticator (Settings → Security) regardless of this flag — enrolling never
# changes anyone's login until enforcement is on.
#
#   OFF (default): leave BLANK or anything other than "true". No login gating —
#     nobody can be locked out. This is the safe default; enroll + test first.
#   ON:  set to exactly "true". After password login, a user WITH a factor must
#     pass the TOTP challenge, and a user whose role requires MFA
#     (ceo/coo/department_head) with no factor is routed to enrollment (never a
#     wall). team_member is optional.
#
# Prereq: enable the TOTP factor in Supabase → Authentication → MFA. Break-glass
# (reset a locked-out user's factor) is documented in docs/MFA.md.
# Read fresh per request — flip it in the Vercel dashboard, no redeploy needed.
MFA_ENFORCEMENT_ENABLED=

# ── Rate limiting (PASTE 2.4 — Part C) ────────────────────────────────────────
# The edge rate limiter (middleware) throttles the auth / AI / webhook endpoints.
# When these two Upstash Redis REST vars are set, limits are exact and shared
# across every edge region (recommended for production). When they are BLANK, the
# limiter transparently falls back to an in-memory per-instance counter — the
# throttle still works, it's just approximate. Create a free Redis DB at
# https://console.upstash.com and copy its REST URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Kill-switch — instant, redeploy-free recovery. Set to the literal "true" to
# bypass rate limiting ENTIRELY (no request is ever throttled). Flip it in the
# Vercel env and the next request is unlimited — no code change, no rebuild.
# Leave blank / unset for normal limiting. This is the panic lever if the
# limiter ever misbehaves in production. The limiter also fails OPEN on any
# store error on its own, so a limiter outage never 429s users regardless.
RATE_LIMIT_DISABLED=

# Windsor.ai — Vesper's Ad Ops connector (V3). A single org-wide API key sent as
# the `api_key` query param to the Windsor Connector API. Server-side ONLY, never
# NEXT_PUBLIC_*. Read at call time inside lib/windsor/client.ts (reads via
# https://connectors.windsor.ai/{connector}, writes via …/{connector}/actions).
# Vesper READS TikTok + Meta ad performance and, only after ceo/coo approval,
# WRITES the approved pause/enable/set-budget change back to the platform. Leave
# blank to show the honest "ad connector not configured" state — no data is
# fabricated when unset. From the Windsor.ai dashboard → API. Write actions must
# be enabled for the Windsor team, or writes return 403 (surfaced, never faked).
# Diag: /api/integrations/ad-ops/diag → { hasKey, mappedBrands } (key never returned).
WINDSOR_API_KEY=

# Optional brand → ad-account map so Vesper can attribute campaigns to brands
# WITHOUT a schema change (the brands table has no place for a platform account
# id). JSON keyed by brand name (case-insensitive) OR brand uuid; values list the
# Windsor advertiser / ad-account id(s) per connector. Unmapped accounts still
# surface — just without a brand ("per brand where mapped"). Example:
#   {"MPire Concepts Co.":{"facebook":"217911345480140"},
#    "Basic City":{"tiktok":"7572146491055915025"}}
WINDSOR_BRAND_MAP=

# Optional currency label for ad spend/budget (Windsor returns spend unlabeled;
# the team's accounts are PHP). Defaults to PHP when unset.
WINDSOR_CURRENCY=

# Optional Ad Ops rule thresholds (all positive numbers; sensible defaults in
# lib/ad-ops/rules.ts). Vesper proposes a PAUSE for losers and a budget SCALE for
# winners; every proposal is still ceo/coo-approval-gated. Currency-valued ones
# assume WINDSOR_CURRENCY.
#   WINDSOR_ADOPS_MIN_SPEND    ignore campaigns spending under this in the window (default 500)
#   WINDSOR_ADOPS_SCALE_ROAS   ROAS at/above which a campaign is a winner (default 2.0)
#   WINDSOR_ADOPS_PAUSE_ROAS   ROAS at/below which a campaign is a loser (default 0.8)
#   WINDSOR_ADOPS_TARGET_CPA   CPA at/below which a campaign is a winner (default 150)
#   WINDSOR_ADOPS_MAX_CPA      CPA at/above which a campaign is a loser (default 600)
#   WINDSOR_ADOPS_GOOD_CTR     CTR% considered healthy (default 1.5)
#   WINDSOR_ADOPS_SCALE_FACTOR budget multiple of recent daily spend on a scale (default 1.2)
WINDSOR_ADOPS_MIN_SPEND=
WINDSOR_ADOPS_SCALE_ROAS=
WINDSOR_ADOPS_PAUSE_ROAS=
WINDSOR_ADOPS_TARGET_CPA=
WINDSOR_ADOPS_MAX_CPA=
WINDSOR_ADOPS_GOOD_CTR=
WINDSOR_ADOPS_SCALE_FACTOR=

# Vesper Studio auto-clipping worker (worker/vesper-clipper.mjs) — OUT-OF-RUNTIME.
# The worker (not the Vercel app) transcribes + cuts video; it needs ffmpeg on
# PATH plus SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY and ANTHROPIC_API_KEY (all
# defined above — NO new paid keys). These extra vars are OPTIONAL tuning, read
# ONLY by the worker process, never by the app. See docs/VESPER_STUDIO.md.
# NOTE: the Phase-2 in-runtime pipeline routes (/api/vesper/transcribe +
# /api/vesper/segment) ALSO read VESPER_SEGMENT_MODEL (server-side, same default)
# and reuse OPENAI_API_KEY / ANTHROPIC_API_KEY — still no new paid keys.
#   VESPER_SEGMENT_MODEL — Claude model for highlight selection (default claude-sonnet-5)
#   VESPER_POLL_MS       — worker loop poll interval in ms (default 15000)
#   VESPER_ONESHOT       — set to 1 to process one job then exit (cron-friendly)
VESPER_SEGMENT_MODEL=
VESPER_POLL_MS=
VESPER_ONESHOT=

# Vesper Studio — Ingest (Phase 1): Cloudinary signed DIRECT replay upload.
# TikTok LIVE replays are large, so the browser uploads the file straight to
# Cloudinary (client → Cloudinary), never through the Vercel runtime. The server
# only mints a short-lived signed-upload signature — CLOUDINARY_API_SECRET is used
# to sign and NEVER reaches the browser. CLOUD_NAME + API_KEY are non-secret (the
# browser needs them to build the request); mark API_SECRET "Sensitive" in Vercel.
# Used by /api/vesper/upload-signature and the /studio/vesper surface.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
